#include <iostream>
#include <cmath>
#include <iomanip>

using namespace std;
const double M_PI = 3.14159265358979323846;

// Подынтегральная функция для задания 2 (π)
double f_pi(double x) {
    return 1.0 / (1.0 + x * x);
}

// Подынтегральная функция для задания 3
double f3(double x) {
    if (x >= 0 && x <= 2.0) {
        return exp(x);
    }
    else {
        return 1/(4.0 - sin(16.0 * M_PI * x));
    }
}

// Функция для вычисления erf(x) с помощью численных квадратур
double erf_num(double x, int n = 1000) {
    if (x == 0) return 0;

    double h = x / n;
    double sum = 0.0;

    for (int i = 0; i <= n; i++) {
        double t = i * h;
        double f = exp(-t * t);

        if (i == 0 || i == n) sum += f;
        else if (i % 2 == 1) sum += 4 * f;
        else sum += 2 * f;
    }

    sum *= h / 3.0;
    return (2.0 / sqrt(M_PI)) * sum;
}

void task1() {
    cout << " ЗАДАНИЕ 1: Таблица erf(x)\n";
    cout << fixed << setprecision(8);
    cout << "    x    |   erf(x)_числ   |   erf(x)_встроенная   |   Погрешность\n";
    cout << "---------|-----------------|------------------------|--------------\n";

    for (int i = 0; i <= 20; i++) {
        double x = i * 0.1;
        double erf_num_val = erf_num(x);
        double erf_builtin = erf(x);
        double error = fabs(erf_num_val - erf_builtin);

        cout << "   " << setw(4) << x << "   | "
            << setw(15) << erf_num_val << " | "
            << setw(22) << erf_builtin << " | "
            << scientific << setprecision(5) << error << "\n";
    }
    cout << endl;
}

